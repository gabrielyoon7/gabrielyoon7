---
import { getText } from '../../i18n/ui';
import {
  categoryLabel,
  categoryUrl,
  formatDate,
  getTagLabels,
  postLang,
  postUrl,
  tagKey,
  tagUrl,
  type Post,
} from '../../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const lang = postLang(post);
const t = getText(lang);
const tagLabels = await getTagLabels(lang);
---

<article class="post-list-item">
  <h2 class="post-list-title">
    <a href={postUrl(post)}>{post.data.title}</a>
    {post.data.pinned && <span class="pinned-badge">{t('post.pinned')}</span>}
    {post.data.draft && <span class="draft-badge">{t('post.draftShort')}</span>}
  </h2>
  <div class="post-meta">
    <a class="post-category" href={categoryUrl(post.data.category, lang)}>
      {categoryLabel(post.data.category, lang)}
    </a>
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
  </div>
  <p class="post-description">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="tag-list" aria-label={t('post.tags')}>
        {post.data.tags.map((tag) => (
          <li>
            <a class="tag" href={tagUrl(tag, lang)}>
              {tagLabels.get(tagKey(tag)) ?? tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
