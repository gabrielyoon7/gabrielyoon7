---
import {
  categoryLabel,
  formatDate,
  getTagLabels,
  postUrl,
  tagKey,
  tagUrl,
  type Post,
} from '../../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const tagLabels = await getTagLabels();
---

<article class="post-list-item">
  <h2 class="post-list-title">
    <a href={postUrl(post)}>{post.data.title}</a>
    {post.data.pinned && <span class="pinned-badge">고정</span>}
    {post.data.draft && <span class="draft-badge">초안</span>}
  </h2>
  <div class="post-meta">
    <span class="post-category">{categoryLabel(post.data.category)}</span>
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  </div>
  <p class="post-description">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="tag-list" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li>
            <a class="tag" href={tagUrl(tag)}>
              {tagLabels.get(tagKey(tag)) ?? tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>
