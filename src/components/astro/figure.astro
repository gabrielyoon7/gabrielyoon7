---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  width?: number;
}

const { src, alt, caption, width = 720 } = Astro.props;
---

<figure class="figure">
  <Image
    src={src}
    alt={alt}
    width={width}
    class="figure-image"
    data-lightbox=""
    loading="lazy"
  />
  {caption && <figcaption class="figure-caption">{caption}</figcaption>}
</figure>

<script>
  document.querySelectorAll('.figure-image').forEach((img) => {
    const el = img as HTMLImageElement;
    if (!el.dataset.lightbox && el.currentSrc) {
      el.dataset.lightbox = el.currentSrc;
    }
  });
</script>
