---
import PageLayout from '../layouts/page-layout.astro';
import { getText } from '../i18n/ui';
import { getPosts, summarizeTags, tagUrl, type Lang } from '../lib/posts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getText(lang);
const tags = summarizeTags(await getPosts({ lang }));
---

<PageLayout lang={lang} title={t('tags.title')} description={t('tags.description')}>
  <header class="page-header">
    <h1>{t('tags.title')}</h1>
    <p>{t('tags.count', { n: tags.length })}</p>
  </header>

  <div class="tag-cloud">
    {
      tags.map(({ key, label, count }) => (
        <a class="tag" href={tagUrl(key, lang)}>
          {label}
          <span class="tag-count">({count})</span>
        </a>
      ))
    }
  </div>
</PageLayout>
