---
import { SITE } from '../site.config';
import { DEFAULT_LANG } from '../content/taxonomy.mjs';
import type { Lang } from '../lib/posts';
import { getText, localizePath } from '../i18n/ui';

interface Props {
  /** 비우면 사이트 이름만 씁니다(홈). */
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  /** public/ 기준 경로(예: "covers/a.png") 또는 절대 URL */
  ogImage?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  /** 페이지 언어. <html lang>과 og:locale에 쓰입니다. */
  lang?: Lang;
  /** 같은 페이지의 다른 언어 버전 (hreflang) */
  alternates?: { lang: Lang; href: string }[];
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website',
  ogImage = SITE.defaultOgImage,
  publishedTime,
  modifiedTime,
  tags = [],
  lang = DEFAULT_LANG,
  alternates = [],
} = Astro.props;

const metaDescription = description ?? getText(lang)('site.description');
const OG_LOCALES: Record<Lang, string> = { ko: 'ko_KR', en: 'en_US' };

const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const image = /^https?:\/\//.test(ogImage)
  ? ogImage
  : new URL(`${base}${ogImage.replace(/^\//, '')}`, Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    {
      alternates.length > 0 && [
        <link rel="alternate" hreflang={lang} href={canonical} />,
        ...alternates.map((a) => (
          <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site).href} />
        )),
      ]
    }
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href={localizePath('rss.xml', lang)} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={OG_LOCALES[lang]} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    {ogType === 'article' && <meta property="article:author" content={SITE.author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={image} />

    <title>{pageTitle}</title>

    <!-- Theme: prevent flash -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch {
          // Storage can be blocked; fall back to the system theme.
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <slot name="footer" />

    {import.meta.env.PROD && (
      <script
        is:inline
        data-goatcounter={`https://${SITE.goatcounter}.goatcounter.com/count`}
        async
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
