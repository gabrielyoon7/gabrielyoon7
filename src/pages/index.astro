---
import PageLayout from '../layouts/page-layout.astro';
import { getCollection } from 'astro:content';
import PostCard from '../components/astro/post-card.astro';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestPosts = posts.slice(0, 3);
---

<PageLayout title="Home" description="React/TypeScript 프론트엔드 개발자의 기술 블로그">
  <section class="hero">
    <h1>Ju Hyun, Yoon</h1>
    <p>
      잡다한 이야기를 남기려고 만들었습니다.
    </p>
    <ul class="link-list">
      <li><a href={`${base}blog/`}>모든 글 보기 →</a></li>
      <li><a href={`${base}about/`}>About →</a></li>
      <li><a href={`${base}tags/`}>Tags →</a></li>
    </ul>
  </section>

  <section>
    <h2 class="section-title">Latest Posts</h2>
    <div class="post-list">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</PageLayout>
