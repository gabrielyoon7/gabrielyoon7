---
import PageLayout from "../layouts/page-layout.astro";
import PostCard from "../components/astro/post-card.astro";
import { getPosts, pinnedFirst } from "../lib/posts";

const base = import.meta.env.BASE_URL;
// 고정 글은 개수와 상관없이 모두, 나머지는 최신 3개
const posts = await getPosts();
const latestPosts = pinnedFirst([
  ...posts.filter((p) => p.data.pinned),
  ...posts.filter((p) => !p.data.pinned).slice(0, 3),
]);
---

<PageLayout>
  <section class="hero">
    <h1>한 번 사는 인생</h1>
    <p>재미를 찾아서</p>
    <ul class="link-list">
      <li><a href={`${base}blog/`}>모든 글 보기 →</a></li>
      <li><a href={`${base}about/`}>About →</a></li>
      <li><a href={`${base}tags/`}>Tags →</a></li>
    </ul>
  </section>

  <section>
    <h2 class="section-title">Latest Posts</h2>
    <div class="post-list">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</PageLayout>
