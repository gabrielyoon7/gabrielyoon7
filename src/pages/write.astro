---
import BrowserWriter from '../browser-writer/browser-writer';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f6f7fb" />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}write/manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}write/icon-180.png`} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="주머니 글쓰기" />
    <title>주머니 글쓰기 | Dev Blog</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <BrowserWriter client:only="react" base={import.meta.env.BASE_URL}>
      <p slot="fallback">글쓰기 도구를 불러오는 중입니다…</p>
    </BrowserWriter>
    <noscript>이 글쓰기 도구는 JavaScript를 켜야 사용할 수 있습니다.</noscript>
  </body>
</html>
