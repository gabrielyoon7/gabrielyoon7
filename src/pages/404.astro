---
import PageLayout from '../layouts/page-layout.astro';
import { getText, localizePath } from '../i18n/ui';

// GitHub Pages는 404 페이지를 하나만 쓰므로 두 언어 안내를 함께 보여 줍니다.
const ko = getText('ko');
const en = getText('en');
---

<PageLayout title="404" description="Page not found" alternates={[]}>
  <div class="not-found">
    <h1>404</h1>
    <p>{ko('notFound.message')}</p>
    <p lang="en">{en('notFound.message')}</p>
    <p class="not-found-actions">
      <a href={localizePath('', 'ko')} class="btn">{ko('notFound.home')}</a>
      <a href={localizePath('', 'en')} class="btn btn-outline" lang="en">{en('notFound.home')}</a>
    </p>
  </div>
</PageLayout>
