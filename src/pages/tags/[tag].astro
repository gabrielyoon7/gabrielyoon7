---
import PageLayout from '../../layouts/page-layout.astro';
import PostCard from '../../components/astro/post-card.astro';
import { getPosts, summarizeTags, tagKey } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();

  return summarizeTags(posts).map(({ key, label }) => ({
    params: { tag: key },
    props: {
      label,
      posts: posts.filter((p) => p.data.tags.some((t) => tagKey(t) === key)),
    },
  }));
}

const { label, posts } = Astro.props;
---

<PageLayout title={`Tag: ${label}`} description={`${label} 태그의 글 목록`}>
  <header class="page-header">
    <h1>Tag: {label}</h1>
    <p>{posts.length} posts</p>
  </header>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</PageLayout>
